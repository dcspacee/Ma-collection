rules_version = '2';
// À copier dans la console Firebase → Firestore Database → Règles, puis « Publier ».
// Chaque utilisateur ne peut lire et écrire que son propre document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
